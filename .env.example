# Copy to .env (which is gitignored) and fill in what you use.
# Everything here is optional - an unconfigured connector simply stays hidden
# from the model. Check with ':connect' in the console.

# --- Brain backend ----------------------------------------------------------
# Which model thinks. Overrides brain.backend / brain.model in config.yaml.
# `openrouter` sends every step to https://openrouter.ai/api/v1 and reads the
# key from OPENROUTER_API_KEY below (or the Credential Vault: `:secret set
# OPENROUTER_API_KEY sk-or-...`). A `:free` model id costs nothing but is rate
# limited, so a busy run may retry.
# BACKEND=openrouter
# JARVIS_BACKEND=openrouter
# MODEL_ID=deepseek/deepseek-v4-flash-0731:free
# JARVIS_MODEL=deepseek/deepseek-v4-flash-0731:free
OPENROUTER_API_KEY=
# Screenshots are only worth sending to a model that accepts them. OpenRouter
# reports the accepted input types per model; deepseek/deepseek-v4-flash-0731 is
# text-only, so leave this at 0 for it (`python run.py --check` says when a
# configured model cannot take images).
JARVIS_VISION=0

# --- Gemini Live Voice ------------------------------------------------------
# The live voice engine. Required for `python run.py --live` (or the browser's
# live button) when live_voice.backend is `api_key`. Keep the key in this ignored
# .env file or the Windows Credential Vault, never in config.yaml.
JARVIS_LIVE_API_KEY=
# Every variable here overrides config.yaml, so a stale value left behind is the
# usual reason live voice runs a different model, voice or engine than the file
# says - GET /api/live/config and `:live` report the effective ones.
# JARVIS_LIVE_PROVIDER=gemini          # gemini (default) | fish | relay | auto
# JARVIS_LIVE_MODEL=gemini-3.8-live
# JARVIS_LIVE_VOICE=Algenib            # Algenib, Aoede, Puck, Charon, Kore, ...
# JARVIS_LIVE_MEDIA_RESOLUTION=medium  # low | medium | high
# JARVIS_LIVE_GOOGLE_SEARCH=auto       # auto | on | off
# `auto` tries grounding and, if the key has no grounding quota, retries without
# it and says so; a refused search tool otherwise takes the whole session down.
# JARVIS_LIVE_SCREEN_SHARE=1           # 1 lets the voice agent ask to see the screen
# JARVIS_LIVE_BACKEND=api_key          # api_key | gcloud
# JARVIS_LIVE_WS_URL=                  # your own OpenAI-Realtime relay, if any

# --- Gmail (read over IMAP) -------------------------------------------------
# The app password is the 16-character one from myaccount.google.com/apppasswords
# (2-step verification must be on). Your normal password will NOT work.
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# --- Discord (message Jarvis from your phone) -------------------------------
# Jarvis answers Discord messages as its own process, so this must be on for
# it to start at all. Check what it would do without connecting:
#   python -m jarvis.discord_bot --check
#   python -m jarvis.discord_bot          # listen until Ctrl-C
JARVIS_DISCORD_LISTEN=0

# --- Discord (bot REST API) -------------------------------------------------
# discord.com/developers/applications -> Bot -> Reset Token.
# Turn ON "Message Content Intent" under Privileged Gateway Intents, or message
# text comes back empty. Invite the bot with View Channels + Read Message History,
# and Send Messages if Jarvis should answer you in a channel.
DISCORD_BOT_TOKEN=

# Who is allowed to message Jarvis (jarvis/discord_bot.py). Your own user id -
# right-click yourself with Developer Mode on > Copy User ID - or your username.
# Left blank, the only account allowed is the application's owner, which is the
# account that created the bot. An unset owner allows nobody, never everybody.
DISCORD_ALLOWED_USERS=

# Also answer server messages that do not mention the bot. Off: direct messages
# and mentions only, which is what a busy server wants.
JARVIS_DISCORD_GUILD=0

# Act on this computer, not just talk: a message that reads like a command
# ("open Notepad") is carried out by an agent the listener builds itself, and
# the result comes back as a message. One task at a time, shared with a console
# running a scheduled job, and a question mid-task is asked in Discord and
# waits for the next message. A separate switch from listening above because it
# is a much larger promise: whoever can message this bot can move this
# machine's mouse and keyboard.
JARVIS_DISCORD_AGENT=0

# --- WhatsApp (Meta Cloud API) ----------------------------------------------
# developers.facebook.com -> your app -> WhatsApp -> API Setup.
# Test tokens expire after 24h; generate a System User token to keep it working.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# The Cloud API cannot fetch past messages - Meta pushes them to a webhook.
# Point this at a JSONL file your webhook appends each message to and Jarvis
# reads it instantly.
WHATSAPP_INBOX=

# --- Connector tuning -------------------------------------------------------
# Seconds a connector read stays cached (0 disables caching). Default 60.
JARVIS_CONNECTOR_TTL=60

# --- Jarvis Remote ----------------------------------------------------------
# Public HTTPS URL of your separately deployed relay_server (Render, etc.).
# Pair devices with --remote-pair / --remote-accept; never put pairing keys here.
JARVIS_REMOTE_URL=https://your-jarvis-relay.onrender.com

# --- Fish Audio TTS (https://fish.audio) ------------------------------------
# API key from fish.audio for high-quality text-to-speech.
# Set voice.engine to 'fish' in config.yaml or JARVIS_TTS_ENGINE=fish to activate.
FISH_AUDIO_API_KEY=
# Optional custom voice model reference ID (leave blank for default):
# FISH_AUDIO_VOICE_ID=
