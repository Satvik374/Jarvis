# Copy to .env (which is gitignored) and fill in what you use.
# Everything here is optional - an unconfigured connector simply stays hidden
# from the model. Check with ':connect' in the console.

# --- Gemini Live Voice ------------------------------------------------------
# Required for `python run.py --live` when live_voice.backend is `api_key`.
# Keep the key in this ignored .env file or Windows Credential Vault, never
# in config.yaml or a committed template.
JARVIS_LIVE_API_KEY=
# Optional overrides:
# JARVIS_LIVE_MODEL=gemini-3.1-flash-live-preview
# JARVIS_LIVE_VOICE=Aoede

# --- Gmail (read over IMAP) -------------------------------------------------
# The app password is the 16-character one from myaccount.google.com/apppasswords
# (2-step verification must be on). Your normal password will NOT work.
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# --- Discord (bot REST API) -------------------------------------------------
# discord.com/developers/applications -> Bot -> Reset Token.
# Turn ON "Message Content Intent" under Privileged Gateway Intents, or message
# text comes back empty. Invite the bot with View Channels + Read Message History.
DISCORD_BOT_TOKEN=

# --- WhatsApp (Meta Cloud API) ----------------------------------------------
# developers.facebook.com -> your app -> WhatsApp -> API Setup.
# Test tokens expire after 24h; generate a System User token to keep it working.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# The Cloud API cannot fetch past messages - Meta pushes them to a webhook.
# Point this at a JSONL file your webhook appends each message to and Jarvis
# reads it instantly.
WHATSAPP_INBOX=

# --- Connector tuning -------------------------------------------------------
# Seconds a connector read stays cached (0 disables caching). Default 60.
JARVIS_CONNECTOR_TTL=60

# --- Jarvis Remote ---------------------------------------------------------
# Public HTTPS URL of your separately deployed relay_server (Render, etc.).
# Pair devices with --remote-pair / --remote-accept; never put pairing keys here.
JARVIS_REMOTE_URL=https://your-jarvis-relay.onrender.com

# --- Fish Audio TTS (https://fish.audio) ------------------------------------
# API key from fish.audio for high-quality text-to-speech.
# Set voice.engine to 'fish' in config.yaml or JARVIS_TTS_ENGINE=fish to activate.
FISH_AUDIO_API_KEY=
# Optional custom voice model reference ID (leave blank for default):
# FISH_AUDIO_VOICE_ID=

