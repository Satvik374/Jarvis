# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
/.pytest-codex-live*/

# Local self-backups (source snapshots should stay outside Git)
.self_backups/

# Jarvis runtime artifacts
dataset/data/screenshots/
dataset/data/trajectories/
*.log
# The "the mouse is in use" file a Discord task and a console share.
discord_task.lock

# Persistent memory (per-machine; not source)
memory.txt
chat_memory.jsonl
*.db
*.sqlite
dataset/data/sessions/
dataset/data/macros/

# Local exploratory tests and captured screens; never source artifacts.
scratch/

# Generated dataset (regenerate with dataset/build_dataset.py) - keep small samples out of git
dataset/data/*.jsonl

# Training outputs
training/outputs/
training/checkpoints/
*.gguf
*.safetensors
*.bin

# Models / caches
.ollama/
models/

# uiautomation stray log (redirected to %LOCALAPPDATA%\Jarvis, but just in case)
@AutomationLog.txt

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

.env

# Remote-pairing keys and local replay cursors (never commit these).
.jarvis_remote/
relay_server/relay_state.json
relay_server/relay_state.json.tmp
/relay_state.json
/relay_state.json.tmp

# Codex/ChatGPT OAuth tokens written by `--codex-login`. The file holds live
# access and refresh tokens, so it must never be committed.
.codex_tokens.json

# Local tool state and test artefacts.
.freebuff/
.pytest_tmp/
